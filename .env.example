# Local model settings. Never commit .env or a real API key.
MODEL_URL = https://model.example/v1
MODEL_NAME = your-model-name
MODEL_API_KEY = replace-locally
# Informational hint for the model server; not sent as a chat API parameter.
TOOL_CALL_PARSER=qwen3_coder
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_TOKENS=4096
AGENT_MAX_ROUNDS=6
AGENT_MAX_CALLS=12
# If multiple raw versions are registered, select an exact default explicitly:
# DEFAULT_DATASET_VERSION=sha256-...

# 可选备用服务：auto 按顺序尝试主服务、备用服务，每个服务每轮最多一次。
MODEL_PROVIDER=auto
MODEL_URL_BACKUP=
MODEL_NAME_BACKUP=
MODEL_API_KEY_BACKUP=
